<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(post.errors.count, "error") %> impidieron que se guardara esta publicación:</h2>

      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div style="margin-bottom: 10px;">
    <%= form.label :title, "Título:", style: "display: block; font-weight: bold;" %>
    <%= form.text_field :title, style: "width: 100%; max-width: 400px; padding: 6px;" %>
  </div>

  <div style="margin-bottom: 10px;">
    <%= form.label :content, "Contenido:", style: "display: block; font-weight: bold;" %>
    <%= form.text_area :content, rows: 5, style: "width: 100%; max-width: 600px; padding: 6px;" %>
  </div>

  <div>
    <%= form.submit "Guardar Publicación", style: "background-color: #28a745; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;" %>
  </div>
<% end %>
